# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored and never committed — nothing here is a real default,

# The company or app name to search for on the App Store.
APP_STORE_SEARCH_TERM=

# Two-letter App Store storefront code, e.g. US, DE, UA.
APP_STORE_COUNTRY=US

# Apple entity type to search for. See Apple's iTunes Search API docs for
# valid values (the type of software/media you want results for).
APP_STORE_ENTITY=

# Max number of results to fetch (Apple accepts 1-200).
APP_STORE_LIMIT=10

# PostgreSQL connection — local Docker instance, see docker-compose.yml.
# These defaults match the compose file and work out of the box for local dev.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=app_store
POSTGRES_USER=app_store
POSTGRES_PASSWORD=app_store

# Metabase — same Postgres instance/credentials as above, but its own
# database (kept separate from POSTGRES_DB, the analytics database).
MB_DB_NAME=metabase
# Encrypts Metabase's stored DB credentials. Generate your own for any real
# deployment: `openssl rand -base64 32`. Any local placeholder works for dev.
MB_ENCRYPTION_SECRET_KEY=
# Used by metabase/setup_dashboard.py to create the admin account on first
# run (and log in on later runs). Change for anything beyond local dev.
MB_SITE_URL=http://localhost:3000
MB_ADMIN_EMAIL=admin@example.com
MB_ADMIN_PASSWORD=AppStoreAdmin123!
